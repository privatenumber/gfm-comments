{
	"name": "gfm-comments",
	"version": "0.0.0-semantic-release",
	"description": "Find the HTML comments that GitHub renders in Markdown, with their source offsets",
	"license": "MIT",
	"repository": "privatenumber/gfm-comments",
	"author": {
		"name": "Hiroki Osame",
		"email": "hiroki.osame@gmail.com"
	},
	"files": [
		"dist",
		"skills"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		"types": "./dist/index.d.mts",
		"default": "./dist/index.mjs"
	},
	"packageManager": "pnpm@12.16.1",
	"scripts": {
		"bench": "node bench/index.ts",
		"bench:ab": "node bench/ab.ts",
		"bench:profile": "node bench/profile.ts",
		"bench:time": "node bench/timing.ts",
		"build": "pkgroll --minify",
		"lint": "lintroll --cache --git",
		"oracle:build": "sh scripts/oracle/build.sh",
		"oracle:compare": "node scripts/oracle/compare.ts",
		"oracle:stack": "node scripts/oracle/compare-stack.ts",
		"size": "node bench/size/index.ts",
		"test": "node tests/index.ts",
		"type-check": "tsc",
		"prepack": "pnpm build && clean-pkg-json"
	},
	"engines": {
		"node": ">=22"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "26.13.0",
			"onFail": "download"
		}
	},
	"devDependencies": {
		"@types/node": "^26.6.5",
		"clean-pkg-json": "^2.0.0",
		"esbuild": "^0.28.2",
		"lintroll": "^1.32.1",
		"manten": "^2.0.2",
		"micromark": "^4.0.3",
		"micromark-extension-gfm": "^3.0.0",
		"mitata": "^1.0.34",
		"parse5": "^8.1.1",
		"pkgroll": "^2.29.0",
		"typescript": "^6.0.3"
	}
}
